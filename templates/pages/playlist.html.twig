{% extends "basefront.html.twig" %}

{% block body %}
    <div class="row mt-3">
        <div class="col">
            <h4 class="text-info mt-5">{{ playlist.name }}</h4>

            <!-- Affichage des catégories -->
            <strong>Catégories :</strong>
            {% set anccategorie = '' %}
            {% for categorie in playlistcategories %}
                {{ categorie.name }}&nbsp;
            {% endfor %}
            <br /><br />

            <!-- Description de la playlist -->
            <strong>Description :</strong><br />
            {{ playlist.description|nl2br }}
            <br /><br />

            <!-- Nombre de formations -->
            <strong>Nombre de formations :</strong> {{ playlist.formations|length }}
        </div>
        <div class="col">
            <!-- Boucle sur l'affichage des formations -->
            {% for formation in playlistformations %}
                <div class="row mt-1">
                    <div class="col-md-auto">
                        {% if formation.miniature %}
                            <a href="{{ path('formations.showone', {id: formation.id}) }}">
                                <img src="{{ formation.miniature }}" alt="{{ formation.title }}">
                            </a>
                        {% endif %}
                    </div>
                    <div class="col d-flex align-items-center">
                        <a href="{{ path('formations.showone', {id: formation.id}) }}" 
                           class="link-secondary text-decoration-none">
                            {{ formation.title }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
