{# templates/baseadmin.html.twig #}

<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}BackOffice - Mediatek Formation{% endblock %}</title>
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        <!-- entête -->
        {% block top %}
            <div class="container">
                <!-- titre -->
                <div class="text-left">
                    <img src="{{ app.request.getBasePath()~'/banniere.jpg' }}" >
                </div>
                <!-- menu -->
                {#
                <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav mr-auto">
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_dashboard') }}">Tableau de Bord</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_formations_index') }}">Formations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_playlists_index') }}">Playlists</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('admin_categories_index') }}">Catégories</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="{{ path('logout') }}">Déconnexion</a>
                            </li>
                        </ul>
                    </div>
                </nav>        
            </div>
            #}
        {% endblock %}
        <!-- corps -->
        <div class="container">
            {% block body %}{% endblock %}
        </div>
        <!-- footer -->
        {% block footer %}
            <div class="container text-center">
                <footer>
                    <hr>
                    <p><small><i>
                        Consultez nos <a class="link-secondary" href="{{ path('cgu') }}">Conditions Générales d'Utilisation</a>
                    </i></small></p>
                </footer>
            </div>
        {% endblock %}
        <!-- javascript -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    </body>
</html>
