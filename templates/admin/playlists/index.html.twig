{# admin/playlists/index.html.twig #}

{% extends "baseadmin.html.twig" %}

{% block body %}
    
    <h1>Gestion des Playlists</h1>
    <a class="btn btn-primary" href="{{ path('admin.playlists.ajouter') }}">Ajouter une playlist</a>
    
    <table class="table table-striped">
        <thead>
            <tr>
                <!-- Colonne pour le nom des playlists -->
                <th class="text-left align-top" scope="col">
                    Playlist<br />
                    <a href="{{ path('admin.playlists.sort', {champ:'name', ordre:'ASC'}) }}" class="btn btn-info btn-sm active" role="button" aria-pressed="true"><</a>
                    <a href="{{ path('admin.playlists.sort', {champ:'name', ordre:'DESC'}) }}" class="btn btn-info btn-sm active" role="button" aria-pressed="true">></a>
                    <form class="form-inline mt-1" method="POST" action="{{ path('admin.playlists.findallcontain', {champ:'name'}) }}">
                        <div class="form-group mr-1 mb-2">
                            <input type="text" class="sm" name="recherche" 
                                   value="{% if valeur|default and not table|default %}{{ valeur }}{% endif %}">
                            <input type="hidden" name="_token" value="{{ csrf_token('filtre_name') }}">
                            <button type="submit" class="btn btn-info mb-2 btn-sm">Filtrer</button>
                        </div>
                    </form>
                </th>
                
                <!-- Colonne pour les catégories -->
                <th class="text-left align-top" scope="col">
                    Catégories
                    <form class="form-inline mt-1" method="POST" action="{{ path('admin.playlists.findallcontain', {champ:'id', table:'categories'}) }}">
                        <select class="form-select form-select-sm" name="recherche" id="recherche" onchange="this.form.submit()">
                            <option value=""></option>
                            {% for categorie in categories %}
                                <option 
                                    {% if valeur|default and valeur == categorie.id %} 
                                        selected
                                    {% endif %} 
                                    value="{{ categorie.id }}">{{ categorie.name }}
                                </option>
                            {% endfor %}
                        </select>
                    </form>
                </th>

                <!-- Colonne pour le nombre de formations -->
                <th class="text-left align-top" scope="col">
                    Nombre de formations<br />
                    <a href="{{ path('admin.playlists.sort', {champ:'formationsCount', ordre:'ASC'}) }}" 
                       class="btn btn-info btn-sm active" role="button" aria-pressed="true"><</a>
                    <a href="{{ path('admin.playlists.sort', {champ:'formationsCount', ordre:'DESC'}) }}" 
                       class="btn btn-info btn-sm active" role="button" aria-pressed="true">></a>
                </th>
                
                <!-- Colonne pour le détail -->
                <th class="text-center align-top" scope="col">&nbsp;</th>				
            </tr>
        </thead>
        <tbody>
            <!-- Boucle sur les playlists -->
            {% if playlists|length > 0 %}
                {% for playlist in playlists %}
                    <tr class="align-middle">
                        <!-- Nom de la playlist -->
                        <td>
                            <h5 class="text-info">{{ playlist.name }}</h5>
                        </td>    

                        <!-- Catégories associées -->
                        <td class="text-left">
                            {% set categories = playlist.categoriesplaylist %}
                            {% if categories|length > 0 %}
                                {% for categorie in categories %}
                                    &nbsp;{{ categorie }}<br />
                                {% endfor %}
                            {% endif %}
                        </td>

                        <!-- Nombre de formations -->
                        <td class="text-center">
                            {{ playlist.formations|length }}
                        </td>
                        
                        <!-- Bouton de détail -->
                        <td class="text-center">
                            <a href="{{ path('admin.playlists.showone', {id: playlist.id}) }}" class="btn btn-secondary">Voir détail</a>
                        </td>
                        
                        <!-- Bouton pour modifier -->
                        <td>
                        <a href="{{ path('admin.playlists.modifier', {id: playlist.id}) }}" class="btn btn-warning btn-sm">Modifier</a>
                        </td>
                        
                        <!-- Bouton pour suprimer -->
                        <td>
                        <form method="post" action="{{ path('admin.playlists.supprimer', {id: playlist.id}) }}" style="display:inline-block;" 
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer la playlist : {{playlist.name}} ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ playlist.id) }}">
                            <button class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                        </td>
                    </tr>
                {% endfor %}	
            {% endif %}
        </tbody>
    </table>
{% endblock %}
